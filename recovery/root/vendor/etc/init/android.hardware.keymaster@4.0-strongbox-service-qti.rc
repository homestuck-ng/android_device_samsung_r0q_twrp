# r0q userdata FBE is skeymast (KeyMint), not QTI strongbox.
# keymaster.b00 / keymaster64.b00 are not on apnhlos, so this HAL abort-loops.
# Leaving it in the vintf manifest makes keystore2 wait forever on
# IKeymasterDevice/strongbox and OrangeFox never leaves the splash.
# The service stays installed and disabled. Do not start it.

service keymaster-sb-4-0 /system/bin/android.hardware.keymaster@4.0-strongbox-service-qti
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    seclabel u:r:recovery:s0
